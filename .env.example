# CareerPath configuration. Copy this file to ".env" and edit the values.
# (".env" holds secrets - do not share or commit it.)

# --- Local MySQL server ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=careerpath

# --- Optional ---
# Port the website listens on (default 3000)
# PORT=3000
# Secret used to sign login cookies. If unset, a random one is generated at start
# (everyone is logged out whenever the server restarts).
# SESSION_SECRET=change-me-to-a-long-random-string
